# Copy this file to .env.local and put your computer's address in it.
# Find it with `ipconfig` (Wi-Fi -> IPv4 Address). Your phone and computer
# must be on the same Wi-Fi, and Laravel must listen on that address, e.g.
#   php artisan serve --host=0.0.0.0 --port=8000
# .env.local is not committed, so each groupmate can use their own address.
EXPO_PUBLIC_API_URL=http://192.168.100.10:8000
